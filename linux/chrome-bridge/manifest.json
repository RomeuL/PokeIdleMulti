{
  "manifest_version": 3,
  "name": "PokeIdle Deck Browser Bridge",
  "version": "1.0.0",
  "description": "Zoom e áudio nativos das contas do deck.",
  "permissions": ["tabs", "storage"],
  "content_scripts": [{ "matches": ["https://pokeidle.io/*", "http://127.0.0.1/*"], "js": ["host.js"], "run_at": "document_start" }],
  "background": { "service_worker": "background.js" }
}
